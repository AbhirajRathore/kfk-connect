{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; font-size: 14px; color: #333; margin: 0; padding: 0; }
    .header { background-color: {{ if eq .Status "firing" }}#c0392b{{ else }}#27ae60{{ end }}; color: white; padding: 16px 24px; }
    .header h2 { margin: 0; font-size: 20px; }
    .header .status { font-size: 13px; opacity: 0.85; margin-top: 4px; }
    .content { padding: 20px 24px; }
    .alert-block { border-left: 4px solid {{ if eq .Status "firing" }}#e74c3c{{ else }}#2ecc71{{ end }}; padding: 12px 16px; margin-bottom: 16px; background: #f9f9f9; border-radius: 2px; }
    .alert-block h3 { margin: 0 0 8px 0; font-size: 15px; }
    .meta { font-size: 12px; color: #666; margin-bottom: 8px; }
    .meta span { display: inline-block; margin-right: 16px; }
    .desc { font-size: 13px; line-height: 1.6; white-space: pre-wrap; }
    .footer { border-top: 1px solid #ddd; padding: 12px 24px; font-size: 12px; color: #888; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: bold; }
    .badge-critical { background: #e74c3c; color: white; }
    .badge-warning { background: #f39c12; color: white; }
    .badge-resolved { background: #27ae60; color: white; }
  </style>
</head>
<body>
  <div class="header">
    <h2>
      {{ if eq .Status "firing" }}🔴{{ else }}✅{{ end }}
      Kafka Connect Alert — {{ .Status | toUpper }}
    </h2>
    <div class="status">
      {{ if eq .Status "firing" }}{{ .Alerts.Firing | len }} alert(s) firing{{ end }}
      {{ if gt (.Alerts.Resolved | len) 0 }} · {{ .Alerts.Resolved | len }} resolved{{ end }}
    </div>
  </div>
  <div class="content">
    {{ range .Alerts }}
    <div class="alert-block">
      <h3>{{ .Annotations.summary }}</h3>
      <div class="meta">
        <span>
          <strong>Severity:</strong>
          {{ if eq .Labels.severity "critical" }}<span class="badge badge-critical">CRITICAL</span>
          {{ else if eq .Labels.severity "warning" }}<span class="badge badge-warning">WARNING</span>
          {{ end }}
        </span>
        {{ with .Labels.region }}<span><strong>Region:</strong> {{ . }}</span>{{ end }}
        {{ with .Labels.env }}<span><strong>Env:</strong> {{ . }}</span>{{ end }}
        {{ with .Labels.worker }}<span><strong>Worker:</strong> {{ . }}</span>{{ end }}
        {{ with .Labels.connector }}<span><strong>Connector:</strong> {{ . }}</span>{{ end }}
        <span><strong>Fired:</strong> {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}</span>
        {{ if .EndsAt }}<span><strong>Resolved:</strong> {{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}</span>{{ end }}
      </div>
      <div class="desc">{{ .Annotations.description }}</div>
    </div>
    {{ end }}
  </div>
  <div class="footer">
    KFK-Connect Monitoring · Grafana: <a href="http://localhost:3000">http://localhost:3000</a> · Prometheus: <a href="http://localhost:9090">http://localhost:9090</a>
  </div>
</body>
</html>
{{ end }}
