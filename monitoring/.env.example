# ──────────────────────────────────────────────────────────────────────────────
# Kafka Connect Monitoring — Environment Variables
# Copy:  cp monitoring/.env.example monitoring/.env
# Then fill every FILL_IN value. Do not commit monitoring/.env (gitignored).
# ──────────────────────────────────────────────────────────────────────────────

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=FILL_IN_strong_password

# ── Alertmanager — Email (Gmail SMTP) ────────────────────────────────────────
SMTP_PASS=FILL_IN_gmail_app_password
ALERT_EMAIL_TO=FILL_IN_your@email.com

# ── Slack (optional) — Prometheus → Alertmanager → Slack ─────────────────────
# Create: Slack → Apps → Incoming Webhooks
SLACK_ALERTS_WEBHOOK=FILL_IN_https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# SLACK_ALERTS_CHANNEL=#kafka-connect-alerts

# ── Healthchecks.io — Slack (dead-man's-switch) ──────────────────────────────
# Server-level heartbeat — pinged every 30 s; alerts Slack if host goes offline
# healthchecks.io settings: Period = 1 min | Grace = 5 min
HC_PING_URL_SERVER=FILL_IN_https://hc-ping.com/YOUR_SERVER_UUID

HC_PING_URL_DUBAI_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID
HC_PING_URL_ANTWERP_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID
HC_PING_URL_INDIA_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID
HC_PING_URL_HK_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID
HC_PING_URL_NY_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID

# HC_PING_URL_DUBAI_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID
# HC_PING_URL_ANTWERP_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID
HC_PING_URL_INDIA_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID
# HC_PING_URL_HK_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID
# HC_PING_URL_NY_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID
