  "uid": "kafka-connect-overview",
  "title": "Kafka Connect \u2014 Overview",
  "description": "Live status of all Kafka Connect inventory workers, connectors, tasks, and logs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "kafka",
    "connect",
    "inventory",
    "kfk-connect"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Worker Status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
