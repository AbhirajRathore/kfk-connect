# ──────────────────────────────────────────────────────────────────────────────
# Kafka Connect Monitoring — Environment Variables
# Copy this file to monitoring/.env and fill in the blanks marked FILL_IN
# ──────────────────────────────────────────────────────────────────────────────

# ── Grafana ──────────────────────────────────────────────────────────────────
# Password for the Grafana admin user (http://<host>:3000)
GRAFANA_ADMIN_PASSWORD=FILL_IN_GRAFANA_PASSWORD

# ── Alertmanager — Email (Gmail SMTP) ────────────────────────────────────────
# Gmail app password (already configured — do not change unless rotated)
SMTP_PASS=euie ghna vfsn mebq

# Recipient email address for all alerts
ALERT_EMAIL_TO=FILL_IN_ALERT_RECIPIENT@example.com

# ── Healthchecks.io — Slack alerting (dead-man's-switch) ─────────────────────
# Create one check per location at https://healthchecks.io
# Settings per check:  Period = 1 minute  |  Grace = 2 minutes
# Connect your Slack workspace in the healthchecks.io integrations tab.
# Then paste the ping URL for each check below.
#
# Format: https://hc-ping.com/<uuid>
#
# Phase 1 — Dev inventory workers (fill these in before starting the stack)
HC_PING_URL_DUBAI_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID_DUBAI_DEV
HC_PING_URL_ANTWERP_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID_ANTWERP_DEV
HC_PING_URL_INDIA_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID_INDIA_DEV
HC_PING_URL_HK_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID_HK_DEV
HC_PING_URL_NY_DEV=FILL_IN_https://hc-ping.com/YOUR_UUID_NY_DEV

# Phase 2 — Prod inventory workers (uncomment and fill in when deploying prod)
# HC_PING_URL_DUBAI_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID_DUBAI_PROD
# HC_PING_URL_ANTWERP_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID_ANTWERP_PROD
# HC_PING_URL_INDIA_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID_INDIA_PROD
# HC_PING_URL_HK_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID_HK_PROD
# HC_PING_URL_NY_PROD=FILL_IN_https://hc-ping.com/YOUR_UUID_NY_PROD
