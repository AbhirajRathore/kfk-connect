[Unit]
Description=Kafka Connect Workers + Monitoring Stack
Documentation=https://github.com/AbhirajRathore/kfk-connect
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/kfk-connect

# Ensure the shared network exists
ExecStartPre=/bin/bash -c 'docker network inspect monitoring_net >/dev/null 2>&1 || docker network create monitoring_net'

# Start monitoring stack first
ExecStart=/bin/bash -c 'cd /root/kfk-connect/monitoring && docker compose up -d'

# Start all 8 workers (4 regions × dev + prod). India lines are commented — uncomment when deployed.
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-dubai/inventory/dev    && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-dubai/inventory/prod   && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-antwerp/inventory/dev  && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-antwerp/inventory/prod && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-hk/inventory/dev      && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-hk/inventory/prod     && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-ny/inventory/dev      && docker compose --env-file .env up -d'
ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-ny/inventory/prod     && docker compose --env-file .env up -d'
# ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-india/inventory/dev   && docker compose --env-file .env up -d'
# ExecStart=/bin/bash -c 'cd /root/kfk-connect/nivid-india/inventory/prod  && docker compose --env-file .env up -d'

# Stop in reverse order
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-ny/inventory/prod      && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-ny/inventory/dev       && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-hk/inventory/prod      && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-hk/inventory/dev       && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-antwerp/inventory/prod && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-antwerp/inventory/dev  && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-dubai/inventory/prod   && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-dubai/inventory/dev    && docker compose --env-file .env down'
# ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-india/inventory/prod  && docker compose --env-file .env down'
# ExecStop=/bin/bash -c 'cd /root/kfk-connect/nivid-india/inventory/dev   && docker compose --env-file .env down'
ExecStop=/bin/bash -c 'cd /root/kfk-connect/monitoring && docker compose down'

TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
